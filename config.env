# Configuration shared by every script in this repo.
#
# To point this at your own box, DON'T edit this file -- copy it to
# config.local.env and change it there. config.local.env is gitignored and
# overrides anything set here, so `git pull` never clobbers your settings and
# your device's address never lands in a commit.
#
#     cp config.env config.local.env && $EDITOR config.local.env

# adb endpoint of the Android TV box. 5555 is the network-adb default.
# Find it with: adb devices  (after `adb tcpip 5555` over USB, or if the box
# already has persist.adb.tcp.port=5555 set).
TV_ADDR=192.168.1.100:5555

# HTTPS port. This is the ONLY port exposed to the LAN, and it also answers
# plaintext HTTP for the /ca.crt trust bootstrap (see README).
HTTPS_PORT=8443

# On-device install directory. /data/local/tmp is chosen because it is writable
# without remounting anything, which is the one path that works on locked boxes.
REMOTE_DIR=/data/local/tmp/tvremote

# Advertised over mDNS as <MDNS_HOST>.local. Only resolves on networks that pass
# mDNS between clients; the IP is the reliable address.
MDNS_HOST=projectorremote
