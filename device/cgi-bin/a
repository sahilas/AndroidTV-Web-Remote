#!/system/bin/sh
# CGI: launch an app on the projector.  a?<shortname>
#
# The request selects a WHITELIST ENTRY, never a package string. The query is
# only ever compared against fixed `case` labels, so nothing from the network is
# interpolated into a shell command — the alternative (a?pkg=<anything>) would
# hand any LAN client arbitrary component launching as root.
#
# NOT using `monkey -c LAUNCHER`: measured on this box, it fails for every
# package including installed ones ("** No activities found to run, monkey
# aborted.", exit 252) — this is a TV-flavoured build and its launcher intents
# don't match what monkey filters on. So resolve the activity and start it.
#
# Settings is a separate case: on this build no package exposes a LAUNCHER
# activity for it, so it goes through the action intent instead (which lands on
# Whale OS's own com.zhiying.settings).
p=; act=
case "$QUERY_STRING" in
  cine) p=com.example.cinepulse ;;
  vlc)  p=org.videolan.vlc ;;
  just) p=com.brouken.player ;;
  next) p=dev.anilbeesetti.nextplayer ;;   # not installed today; works if it returns
  set)  act=android.settings.SETTINGS ;;
  *) printf 'HTTP/1.0 400 Bad\r\nContent-Length: 3\r\nConnection: close\r\n\r\nno\n'; exit 0 ;;
esac

fail(){ printf 'HTTP/1.0 500\r\nContent-Length: 3\r\nConnection: close\r\n\r\nno\n'; exit 0; }

# `am start` prints "Error: ..." but does not reliably exit nonzero, so check the
# output too. A "Warning: Activity not started, its current task has been brought
# to the front" is success (the app was already open).
start(){
  out=$(am start "$@" 2>&1) || fail
  case "$out" in *Error*|*Exception*) fail ;; esac
}

if [ -n "$act" ]; then
  start -a "$act"
else
  a=$(cmd package resolve-activity --brief -c android.intent.category.LAUNCHER "$p" \
      2>/dev/null | tail -1 | tr -d '\r')
  case "$a" in
    "$p"/*) ;;                 # got "<pkg>/<activity>" — anything else is a failure
    *) fail ;;
  esac
  start -n "$a"
fi
printf 'HTTP/1.0 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 3\r\nConnection: close\r\n\r\nok\n'
