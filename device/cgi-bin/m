#!/system/bin/sh
# CGI: pointer injection for the Touchpad UI. Two styles:
#
#  Absolute direct-touch (screen is 1920x1080; phone sends absolute ints):
#    m?tap=X,Y                 -> input tap X Y
#    m?swipe=X1,Y1,X2,Y2[,DUR] -> input swipe ...            (scroll/drag)
#
#  Relative air-mouse (moves the real "Hi mouse" cursor via sendevent):
#    m?rel=DX,DY               -> REL_X/REL_Y motion (DX/DY may be negative)
#    m?click=1                 -> BTN_MOUSE down+up (left click)
#    m?wheel=N                 -> REL_WHEEL N (scroll; may be negative)
#
# User values are digits, comma and minus only (validated) before hitting the shell.
# sendevent type/code constants are fixed in this script, never from the request.
qs="$QUERY_STRING"
op="${qs%%=*}"; val="${qs#*=}"
case "$val" in *[!0-9,-]* | "")
  printf 'HTTP/1.0 400\r\nContent-Length: 3\r\nConnection: close\r\n\r\nno\n'; exit 0 ;;
esac

reply(){ printf 'HTTP/1.0 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 3\r\nConnection: close\r\n\r\nok\n'; }

# resolve + cache the "Hi mouse" event node (robust across reboots / renumbering)
CF=/data/local/tmp/tvremote/.mouseev
mev(){
  m=$(cat "$CF" 2>/dev/null)
  if [ -z "$m" ] || [ ! -e "$m" ]; then
    ev=$(grep -A6 'Name="Hi mouse"' /proc/bus/input/devices | grep -m1 -oE 'event[0-9]+')
    m="/dev/input/$ev"; echo "$m" > "$CF"
  fi
  echo "$m"
}

IFS=,; set -- $val; unset IFS
case "$op" in
  tap)   [ -n "$2" ] && input tap "$1" "$2" >/dev/null 2>&1 ;;
  swipe) [ -n "$4" ] && input swipe "$1" "$2" "$3" "$4" "${5:-120}" >/dev/null 2>&1 ;;
  rel)   d=$(mev); [ -e "$d" ] && { sendevent "$d" 2 0 "$1"; sendevent "$d" 2 1 "$2"; sendevent "$d" 0 0 0; } >/dev/null 2>&1 ;;
  click) d=$(mev); [ -e "$d" ] && { sendevent "$d" 1 272 1; sendevent "$d" 0 0 0; sendevent "$d" 1 272 0; sendevent "$d" 0 0 0; } >/dev/null 2>&1 ;;
  wheel) d=$(mev); [ -e "$d" ] && { sendevent "$d" 2 8 "$1"; sendevent "$d" 0 0 0; } >/dev/null 2>&1 ;;
  *) printf 'HTTP/1.0 400\r\nContent-Length: 3\r\nConnection: close\r\n\r\nno\n'; exit 0 ;;
esac
reply
